@using Eventra.Models
@{
    ViewData["Title"] = "Guest Profile";
    var user = ViewBag.TargetUser as User;
    var organizerEvents = ViewBag.OrganizerEvents as List<Event>;
    var registeredIds   = ViewBag.RegisteredEventIds  as HashSet<int> ?? new HashSet<int>();
    var waitingIds      = ViewBag.WaitingListEventIds  as HashSet<int> ?? new HashSet<int>();
    var checkedInIds    = ViewBag.CheckedInEventIds    as HashSet<int> ?? new HashSet<int>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/styleprofile.css" asp-append-version="true" />
}

<style>
    .view-page   { padding: 60px 0 90px; }
    .view-card   {
        max-width: 600px; margin: 0 auto;
        background: var(--card-bg, #f8f3ed);
        border-radius: 24px; padding: 44px 40px;
        box-shadow: 0 12px 32px rgba(55,34,46,.12);
    }
    .view-avatar-img {
        width: 110px; height: 110px; border-radius: 50%;
        object-fit: cover; object-position: center;
        border: 3px solid var(--primary); display: block; margin: 0 auto 22px;
    }
    .view-avatar-initials {
        width: 110px; height: 110px; border-radius: 50%;
        background: var(--primary); color: #f5ebdf;
        display: flex; align-items: center; justify-content: center;
        font-family: 'Cormorant Garamond', serif; font-size: 2.6rem; font-weight: 600;
        margin: 0 auto 22px;
    }
    .view-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2.4rem; text-align: center; color: var(--text-main); margin-bottom: 4px;
    }
    .view-role {
        text-align: center; color: var(--text-soft);
        font-size: 0.82rem; letter-spacing: 1.8px; text-transform: uppercase; margin-bottom: 30px;
    }
    .view-info-row {
        display: flex; align-items: center; gap: 14px;
        background: #fffaf5; border-radius: 12px;
        padding: 13px 18px; margin-bottom: 10px;
    }
    .view-info-label { font-weight: 700; color: var(--primary); min-width: 88px; font-size: 0.85rem; }
    .view-info-value { color: var(--text-main); font-size: 0.94rem; word-break: break-all; }
    .view-divider { border: none; border-top: 1px solid #e0d4d8; margin: 28px 0; }
    .view-events-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.9rem; color: var(--text-main); margin-bottom: 6px;
    }
    .view-events-sub { color: var(--text-soft); font-size: 0.83rem; margin-bottom: 18px; }
    .view-event-row {
        display: flex; align-items: center; justify-content: space-between;
        gap: 14px; padding: 13px 18px;
        background: #fffaf5; border-radius: 12px; margin-bottom: 10px;
    }
    .view-event-info { flex: 1; min-width: 0; }
    .view-event-name { font-weight: 600; font-size: 0.92rem; color: var(--text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .view-event-date { color: var(--text-soft); font-size: 0.8rem; margin-top: 2px; }
    .badge {
        flex-shrink: 0; padding: 4px 13px; border-radius: 999px;
        font-size: 0.78rem; font-weight: 700; white-space: nowrap;
    }
    .badge-checked-in  { background: #e8f4fd; color: #1a4f7a; }
    .badge-registered  { background: #edfaf3; color: #1a6344; }
    .badge-waiting     { background: #fffbf0; color: #7a5c10; }
    .badge-none        { background: #fdf1f1; color: #7a2020; }
    .view-empty { color: var(--text-soft); font-size: 0.9rem; padding: 12px 0; }
    .view-back { display: inline-flex; align-items: center; gap: 6px; color: var(--text-soft); font-size: 0.9rem; margin-bottom: 28px; }
    .view-back:hover { color: var(--primary); }
</style>

<main class="view-page">
    <div class="container">
        <a href="javascript:history.back()" class="view-back">&#8592; Back</a>

        <div class="view-card">

            @if (!string.IsNullOrEmpty(user?.ProfilePhotoPath))
            {
                <img src="@Url.Content(user.ProfilePhotoPath)" alt="@user?.FirstName" class="view-avatar-img" />
            }
            else
            {
                <div class="view-avatar-initials">
                    @(user?.FirstName?.Length > 0 ? user.FirstName[0].ToString() : "")@(user?.LastName?.Length > 0 ? user.LastName[0].ToString() : "")
                </div>
            }

            <h1 class="view-name">@user?.FirstName @user?.LastName</h1>
            <p class="view-role">@user?.Role</p>

            <div class="view-info-row">
                <span class="view-info-label">Username</span>
                <span class="view-info-value">@@@user?.Username</span>
            </div>
            <div class="view-info-row">
                <span class="view-info-label">Email</span>
                <span class="view-info-value">@user?.Email</span>
            </div>

            @if (organizerEvents != null)
            {
                <hr class="view-divider" />
                <h2 class="view-events-title">Event Registration Status</h2>
                <p class="view-events-sub">Showing your upcoming approved events only.</p>

                @if (organizerEvents.Any())
                {
                    @foreach (var ev in organizerEvents)
                    {
                        string badgeClass;
                        string badgeLabel;

                        if (checkedInIds.Contains(ev.Id))
                        {
                            badgeClass = "badge-checked-in";
                            badgeLabel = "Already checked in";
                        }
                        else if (registeredIds.Contains(ev.Id))
                        {
                            badgeClass = "badge-registered";
                            badgeLabel = "Registered";
                        }
                        else if (waitingIds.Contains(ev.Id))
                        {
                            badgeClass = "badge-waiting";
                            badgeLabel = "On waiting list";
                        }
                        else
                        {
                            badgeClass = "badge-none";
                            badgeLabel = "Not registered";
                        }

                        <div class="view-event-row">
                            <div class="view-event-info">
                                <div class="view-event-name">@ev.Title</div>
                                <div class="view-event-date">@ev.EventDate.ToString("dd MMM yyyy") &bull; @ev.City</div>
                            </div>
                            <span class="badge @badgeClass">@badgeLabel</span>
                        </div>
                    }
                }
                else
                {
                    <p class="view-empty">You have no upcoming approved events.</p>
                }
            }

        </div>
    </div>
</main>
