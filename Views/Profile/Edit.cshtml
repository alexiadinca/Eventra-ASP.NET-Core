@model Eventra.Models.ViewModels.EditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/styleeditprofile.css" asp-append-version="true" />
}

<main class="edit-page">
    <div class="container edit-wrapper">
        <section class="edit-left">
            <p class="eyebrow">Manage your personal information</p>
            <h1>Edit profile</h1>
            <p class="intro-text">Update your personal details and keep your Eventra attendee profile accurate.</p>
        </section>

        <section class="edit-card">
            <h2>Edit Information</h2>
            <p class="card-subtitle">Update your profile details below</p>

            <form asp-action="Edit" method="post" enctype="multipart/form-data" class="edit-form">
                <div asp-validation-summary="All" class="text-danger" style="margin-bottom:12px;"></div>

                <div class="form-row">
                    <div class="input-group">
                        <label asp-for="FirstName"></label>
                        <input asp-for="FirstName" />
                    </div>
                    <div class="input-group">
                        <label asp-for="LastName"></label>
                        <input asp-for="LastName" />
                    </div>
                </div>

                <div class="input-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" />
                </div>

                <div class="input-group">
                    <label asp-for="PhoneNumber"></label>
                    <input asp-for="PhoneNumber" />
                </div>

                <div class="input-group photo-upload-group">
                    <label>Profile Photo</label>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentPhotoPath as string))
                    {
                        <img src="@Url.Content(ViewBag.CurrentPhotoPath)" alt="Current profile photo" class="photo-preview" />
                    }
                    <input type="file" name="profilePhoto" accept=".jpg,.jpeg,.png,.webp,image/*" />
                    <small class="photo-hint">Max 5 MB &mdash; JPG, PNG or WEBP. Leave blank to keep your current photo.</small>
                </div>

                <div class="form-actions">
                    <button type="submit" class="save-btn">Save Changes</button>
                    <a asp-controller="Profile" asp-action="Index" class="cancel-btn">Cancel</a>
                </div>
            </form>

            <div style="margin-top:28px; padding-top:24px; border-top:1px solid #e0d4d8;">
                <p style="color:var(--text-soft); font-size:0.9rem; margin-bottom:12px;">Need to update your password?</p>
                <a asp-controller="Profile" asp-action="ChangePassword" class="save-btn" style="display:inline-block; text-decoration:none;">Change Password</a>
            </div>

        </section>
    </div>
</main>