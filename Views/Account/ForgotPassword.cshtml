@model Eventra.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

@section Styles {
    <link rel="stylesheet" href="~/css/stylesignin.css" asp-append-version="true" />
}

<main class="signin-page">
    <div class="container signin-wrapper">

        <section class="signin-left">
            <p class="eyebrow">Account recovery</p>
            <h1>Forgot your password?</h1>
            <p class="intro-text">
                Enter the email address or username linked to your account. If it is eligible, you will be taken directly to the password reset form.
            </p>
            <div class="benefits-box">
                <h3>Please note</h3>
                <ul>
                    <li>Demo and seeded accounts cannot reset their password</li>
                    <li>Only accounts you created yourself are eligible</li>
                    <li>No email will be sent — this is a local demo flow</li>
                </ul>
            </div>
        </section>

        <section class="signin-card">
            <h2>Find your account</h2>
            <p class="card-subtitle">Enter your email or username to continue</p>

            <form asp-action="ForgotPassword" method="post" class="signin-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:12px;"></div>

                <div class="input-group">
                    <label asp-for="EmailOrUsername">Email or Username</label>
                    <input asp-for="EmailOrUsername" placeholder="you@example.com or username" />
                    <span asp-validation-for="EmailOrUsername" class="text-danger"></span>
                </div>

                <button type="submit" class="signin-btn">Continue</button>
            </form>

            <p class="register-text">
                Remembered it?
                <a asp-controller="Account" asp-action="SignIn">Back to Sign In</a>
            </p>
        </section>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
